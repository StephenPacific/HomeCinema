{
  "manifest_version": 3,
  "name": "Home Cinema Tab Audio",
  "version": "0.4.0",
  "description": "Create a room and send the current Chrome tab's audio directly to browser Speakers over WebRTC.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "offscreen", "storage", "tabCapture"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Home Cinema",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
