{
  "manifest_version": 3,
  "name": "Home Cinema Tab Audio",
  "version": "0.3.2",
  "description": "Send the current Chrome tab's audio to Home Cinema speakers over WebRTC.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "offscreen", "storage", "tabCapture"],
  "action": {
    "default_title": "Home Cinema",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
