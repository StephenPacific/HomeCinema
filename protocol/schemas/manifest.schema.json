{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-cinema.local/protocol/manifest.schema.json",
  "title": "Asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_hash", "assets"],
  "properties": {
    "manifest_hash": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "url", "content_hash", "size_bytes", "duration_ms"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "url": { "type": "string", "minLength": 1 },
          "content_hash": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "mime_type": { "type": ["string", "null"] }
        }
      }
    }
  }
}
