diff --git a/scripts/tests/live-export.c b/scripts/tests/live-export.c
new file mode 100644
index 0000000..dc6a9f5
--- /dev/null
+++ b/scripts/tests/live-export.c
@@ -0,0 +1,72 @@
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include "SyncForgeRT.h"
+
+typedef struct { SFSourceRing *ring; _Atomic bool done; } ConcurrentCapture;
+static void *capture_writer(void *opaque) {
+    ConcurrentCapture *capture = opaque;
+    float left[1024], right[1024];
+    for (int chunk = 0; chunk < 3000; chunk++) {
+        float value = (chunk & 1) ? 0.25f : 0.5f;
+        for (int i = 0; i < 1024; i++) { left[i] = value; right[i] = -value; }
+        sf_ring_write(capture->ring, left, right, 1, 1024,
+            1000000000 + (uint64_t)llround(chunk * 1024.0 / 48000 * 1e9), 1);
+    }
+    atomic_store(&capture->done, true);
+    return NULL;
+}
+
+static void concurrent_export(void) {
+    ConcurrentCapture capture = { .ring = sf_ring_create(16384, 48000, 1000000000) };
+    atomic_init(&capture.done, false);
+    assert(capture.ring);
+    pthread_t writer;
+    assert(pthread_create(&writer, NULL, capture_writer, &capture) == 0);
+    unsigned accepted = 0;
+    float out[256];
+    while (!atomic_load(&capture.done)) {
+        int64_t written = sf_ring_write_frame(capture.ring);
+        if (written >= 512 && sf_ring_copy_stereo(capture.ring, written - 512, 128, out)) {
+            for (int i = 0; i < 128; i++) assert(out[2 * i] == -out[2 * i + 1]);
+            accepted++;
+        }
+    }
+    assert(pthread_join(writer, NULL) == 0);
+    assert(accepted > 0);
+    sf_ring_destroy(capture.ring);
+}
+
+int main(void) {
+    SFSourceRing *ring = sf_ring_create(16384, 48000, 1000000000);
+    assert(ring);
+    float left[1024], right[1024], out[2048];
+    for (int i = 0; i < 1024; i++) { left[i] = i / 2048.0f; right[i] = -left[i]; }
+    sf_ring_write(ring, left, right, 1, 1024, 1000000000, 1);
+    assert(sf_ring_copy_stereo(ring, 42, 256, out));
+    for (int i = 0; i < 256; i++) {
+        assert(out[2 * i] == left[i + 42]);
+        assert(out[2 * i + 1] == right[i + 42]);
+    }
+    assert(!sf_ring_copy_stereo(ring, -1, 1, out));
+    assert(!sf_ring_copy_stereo(ring, 1000, 100, out));
+    assert(!sf_ring_copy_stereo(ring, 0, 0, out));
+    assert(!sf_ring_copy_stereo(ring, INT64_MAX, 2, out));
+    for (int chunk = 1; chunk < 32; chunk++) {
+        uint64_t host = 1000000000 + (uint64_t)llround(chunk * 1024.0 / 48000 * 1e9);
+        sf_ring_write(ring, left, right, 1, 1024, host, 1);
+    }
+    assert(!sf_ring_copy_stereo(ring, 0, 256, out));
+    assert(sf_ring_copy_stereo(ring, 31 * 1024 + 42, 256, out));
+    for (int i = 0; i < 256; i++) assert(out[2 * i] == left[i + 42]);
+    left[10] = NAN; right[20] = INFINITY; left[30] = 2; right[40] = -2;
+    sf_ring_write(ring, left, right, 1, 1024, 1000000000 + (uint64_t)llround(32 * 1024.0 / 48000 * 1e9), 1);
+    assert(sf_ring_copy_stereo(ring, 32 * 1024, 256, out));
+    assert(out[20] == 0 && out[41] == 0 && out[60] == 1 && out[81] == -1);
+    sf_ring_destroy(ring);
+    concurrent_export();
+    puts("PASS: stereo channel preservation, history/wrap bounds, invalid ranges, non-finite samples and concurrent stereo-pair consistency");
+    return 0;
+}
