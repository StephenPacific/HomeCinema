+struct MasterClockPin: Sendable {
+    let host: UInt64
+    let masterMs: Double
+    let ticksPerSecond: Double
+
+    static func capture(masterOffsetMs: Double) -> MasterClockPin {
+        let before = HostTime.now()
+        let unixMs = Date().timeIntervalSince1970 * 1000
+        let after = HostTime.now()
+        return MasterClockPin(host: before &+ ((after &- before) / 2),
+                              masterMs: unixMs + masterOffsetMs, ticksPerSecond: HostTime.ticksPerSecond)
+    }
+
+    func timestamp(frame: Int64, timeline: ProgramTimelineSnapshot) -> Double? {
+        guard ticksPerSecond.isFinite, ticksPerSecond > 0,
+              let ticks = timeline.hostOffsetTicks(frame: frame, relativeTo: host) else { return nil }
+        let value = masterMs + ticks * 1000 / ticksPerSecond
+        return value.isFinite ? value : nil
+    }
+}
