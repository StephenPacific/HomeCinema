diff --git a/SyncForgeKit/Sources/SyncForgeRT/sf_export.c b/SyncForgeKit/Sources/SyncForgeRT/sf_export.c
new file mode 100644
index 0000000..f95dcf1
--- /dev/null
+++ b/SyncForgeKit/Sources/SyncForgeRT/sf_export.c
@@ -0,0 +1,32 @@
+// Non-real-time export of captured program audio. No networking or allocation is
+// introduced into the capture or renderer callbacks.
+#include "sf_internal.h"
+
+bool sf_ring_copy_stereo(SFSourceRing *ring, int64_t start, uint32_t count, float *out) {
+    if (!ring || !out || count == 0) return false;
+    int64_t capacity = (int64_t)sf_ring_capacity(ring);
+    // Retain at least half the ring as overwrite headroom. Export copies are
+    // short (~20 ms) and normally read ~100 ms behind the capture writer.
+    int64_t guard = capacity / 2;
+    int64_t before = sf_ring_write_frame(ring);
+    if (start < 0 || (int64_t)count > capacity / 4 || start > INT64_MAX - count
+        || start + (int64_t)count > before || start < before - capacity + guard) return false;
+    const _Atomic uint64_t *data = sf_ring_export_data_internal(ring);
+    uint32_t mask = sf_ring_mask_internal(ring);
+    for (uint32_t i = 0; i < count; i++) {
+        uint32_t index = (uint32_t)((uint64_t)(start + i) & mask);
+        uint64_t pair = atomic_load_explicit(&data[index], memory_order_relaxed);
+        uint32_t leftBits = (uint32_t)pair, rightBits = (uint32_t)(pair >> 32);
+        float left, right;
+        memcpy(&left, &leftBits, sizeof left);
+        memcpy(&right, &rightBits, sizeof right);
+        out[2u * i] = isfinite(left) ? fminf(1.0f, fmaxf(-1.0f, left)) : 0.0f;
+        out[2u * i + 1u] = isfinite(right) ? fminf(1.0f, fmaxf(-1.0f, right)) : 0.0f;
+    }
+    int64_t after = sf_ring_write_frame(ring);
+    if (after < before || start < after - capacity + guard) {
+        memset(out, 0, (size_t)count * 2u * sizeof(float));
+        return false;
+    }
+    return true;
+}
diff --git a/scripts/check-rt-stability.sh b/scripts/check-rt-stability.sh
new file mode 100755
index 0000000..191d398
--- /dev/null
+++ b/scripts/check-rt-stability.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+# Standalone offline C kernel checks. Works with macOS Command Line Tools;
+# does not require XCTest/full Xcode and never opens audio devices.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+test_dir=$(mktemp -d "${TMPDIR:-/tmp}/syncforge-rt-stability.XXXXXX")
+trap 'rm -rf "$test_dir"' EXIT
+flags=(-std=c11 -O2)
+case "${1:-}" in
+  "") ;;
+  --sanitize) flags+=(-g -fsanitize=address,undefined -fno-omit-frame-pointer) ;;
+  *) echo "usage: scripts/check-rt-stability.sh [--sanitize]" >&2; exit 2 ;;
+esac
+clang "${flags[@]}" -I SyncForgeKit/Sources/SyncForgeRT/include \
+  scripts/rt-stability-check.c \
+  SyncForgeKit/Sources/SyncForgeRT/sf_ring.c \
+  SyncForgeKit/Sources/SyncForgeRT/sf_renderer.c \
+  SyncForgeKit/Sources/SyncForgeRT/sf_sinc.c \
+  -o "$test_dir/check"
+"$test_dir/check"
diff --git a/scripts/rt-stability-check.c b/scripts/rt-stability-check.c
new file mode 100644
index 0000000..d6b9ee2
--- /dev/null
+++ b/scripts/rt-stability-check.c
@@ -0,0 +1,128 @@
+// Offline regressions of the real C kernel. Does not open HAL devices or microphones.
+#include <stdio.h>
+#include <stdlib.h>
+#include <math.h>
+#include <string.h>
+#include "SyncForgeRT.h"
+
+#define N 512
+static const double rate=48000.0, tps=1e9;
+static void render(SFRenderer *renderer, double host, float out[N*2]) {
+    memset(out,0,N*2*sizeof(float));
+    AudioBufferList abl={.mNumberBuffers=1,.mBuffers={{.mNumberChannels=2,.mDataByteSize=N*2*sizeof(float),.mData=out}}};
+    sf_renderer_render(renderer,&abl,N,(uint64_t)llround(host),1.0);
+}
+static void setup(SFSourceRing **ring, SFRenderer **renderer, int dsp) {
+    *ring=sf_ring_create(262144,rate,tps); *renderer=sf_renderer_create(*ring,rate,8192,tps);
+    SFRendererParams p;sf_params_init(&p);p.delaySeconds=.05;p.fadeInSeconds=.001;p.limiterEnabled=0;
+    if(dsp){p.dspEnabled=1;p.numBiquads=1;sf_params_set_biquad(&p,0,1,0,0,0,0);}
+    sf_renderer_set_params(*renderer,&p);
+}
+static int nonfinite(void){
+    SFSourceRing *ring;SFRenderer *renderer;setup(&ring,&renderer,1);
+    float in[N],out[N*2];double host=1e12;int invalid=0;double last=0;
+    for(int c=0;c<250;c++){
+        for(int i=0;i<N;i++)in[i]=.5f;
+        if(c==150){in[30]=NAN;in[31]=INFINITY;in[32]=-INFINITY;}
+        sf_ring_write(ring,in,in,1,N,(uint64_t)llround(host),1);
+        render(renderer,host+.012*tps,out);
+        for(int i=0;i<N*2;i++)if(!isfinite(out[i]))invalid++;
+        last=out[N*2-2];host+=(double)N/rate*tps;
+    }
+    printf("non-finite capture: invalid output samples=%d, recovered tail=%.6f\n",invalid,last);
+    sf_renderer_destroy(renderer);sf_ring_destroy(ring);
+    return invalid==0&&fabs(last-.5)<1e-4;
+}
+static int starvation(void){
+    SFSourceRing *ring;SFRenderer *renderer;setup(&ring,&renderer,0);
+    float in[N],out[N*2];for(int i=0;i<N;i++)in[i]=.5f;
+    double host=1e12;float previous=0;double step=0;int detected=0,tailZero=0;SFRendererStats before={0},stats={0};
+    for(int c=0;c<200;c++){
+        sf_ring_write(ring,in,in,1,N,(uint64_t)llround(host),1);
+        render(renderer,host+.012*tps,out);previous=out[N*2-2];host+=(double)N/rate*tps;
+    }
+    sf_renderer_get_stats(renderer,&before,false);
+    for(int c=0;c<40;c++){
+        render(renderer,host+.012*tps,out);host+=(double)N/rate*tps;
+        sf_renderer_get_stats(renderer,&stats,false);
+        if(!detected&&stats.underruns>before.underruns){
+            for(int i=0;i<N;i++){double d=fabs(out[2*i]-previous);if(d>step)step=d;previous=out[2*i];}
+            detected=1;
+        }else previous=out[N*2-2];
+        if(c==39)tailZero=fabs(out[N*2-2])<1e-8;
+    }
+    printf("capture starvation: max edge step=%.6f, underruns=%llu, long-gap silence=%s\n",step,(unsigned long long)(stats.underruns-before.underruns),tailZero?"yes":"no");
+    sf_renderer_destroy(renderer);sf_ring_destroy(ring);
+    return detected&&step<.005&&tailZero&&stats.underruns>before.underruns;
+}
+
+static double tone(double t) {
+    return .22*sin(2*M_PI*440*t)+.18*sin(2*M_PI*1234.5*t+.4);
+}
+
+static int normal_audio(double outputRate, double sourcePPM, double outputPPM, double seconds) {
+    const double sourceActual=rate*(1+sourcePPM*1e-6);
+    const double outputActual=outputRate*(1+outputPPM*1e-6);
+    const double sourcePeriod=(double)N/sourceActual*tps;
+    const double outputPeriod=(double)N/outputActual*tps;
+    const double lead=.012,delay=.1;
+    SFSourceRing *ring=sf_ring_create(262144,rate,tps);
+    SFRenderer *renderer=sf_renderer_create(ring,outputRate,8192,tps);
+    SFRendererParams p;sf_params_init(&p);p.delaySeconds=delay;p.fadeInSeconds=.001;p.limiterEnabled=0;
+    sf_renderer_set_params(renderer,&p);
+    float in[N],out[N*2];
+    const double start=1e12,end=start+seconds*tps;
+    double captureNext=start,outputNext=start+lead*tps,sig=0,error=0;
+    while(1){
+        double captureDue=captureNext+sourcePeriod+.001*tps;
+        double outputDue=outputNext-lead*tps;
+        double due=captureDue<outputDue?captureDue:outputDue;
+        if(due>end)break;
+        if(captureDue<=outputDue){
+            for(int i=0;i<N;i++)in[i]=(float)tone((captureNext+(double)i/sourceActual*tps)/tps);
+            sf_ring_write(ring,in,in,1,N,(uint64_t)llround(captureNext),rate/sourceActual);
+            captureNext+=sourcePeriod;
+        }else{
+            memset(out,0,sizeof out);
+            AudioBufferList abl={.mNumberBuffers=1,.mBuffers={{.mNumberChannels=2,.mDataByteSize=sizeof out,.mData=out}}};
+            sf_renderer_render(renderer,&abl,N,(uint64_t)llround(outputNext),outputRate/outputActual);
+            if(outputNext>start+2*tps){
+                for(int i=0;i<N;i++){
+                    double ideal=tone((outputNext+(double)i/outputActual*tps)/tps-delay);
+                    double e=out[2*i]-ideal;sig+=ideal*ideal;error+=e*e;
+                }
+            }
+            outputNext+=outputPeriod;
+        }
+    }
+    SFRendererStats stats={0};sf_renderer_get_stats(renderer,&stats,false);
+    double snr=10*log10(sig/fmax(error,1e-30));
+    printf("normal %.1f kHz (source %+.0f ppm/output %+.0f ppm, %.0f s): SNR=%.2f dB, underruns=%llu, resyncs=%llu, error=%.3f us\n",outputRate/1000,sourcePPM,outputPPM,seconds,snr,(unsigned long long)stats.underruns,(unsigned long long)stats.resyncs,stats.servoErrorSeconds*1e6);
+    int ok=snr>60&&stats.underruns==0&&stats.resyncs==0&&fabs(stats.servoErrorSeconds)<20e-6;
+    sf_renderer_destroy(renderer);sf_ring_destroy(ring);return ok;
+}
+
+static int poisoned_filter(void) {
+    SFSourceRing *ring;SFRenderer *renderer;setup(&ring,&renderer,1);
+    float in[N],out[N*2];for(int i=0;i<N;i++)in[i]=.5f;
+    double host=1e12,last=0;int invalid=0;
+    for(int c=0;c<220;c++){
+        if(c==150||c==151){
+            SFRendererParams p;sf_params_init(&p);p.delaySeconds=.05;p.fadeInSeconds=.001;p.limiterEnabled=0;p.dspEnabled=1;p.numBiquads=1;
+            sf_params_set_biquad(&p,0,c==150?NAN:1,0,0,0,0);sf_renderer_set_params(renderer,&p);
+        }
+        sf_ring_write(ring,in,in,1,N,(uint64_t)llround(host),1);render(renderer,host+.012*tps,out);
+        for(int i=0;i<N*2;i++)if(!isfinite(out[i]))invalid++;
+        last=out[N*2-2];host+=(double)N/rate*tps;
+    }
+    printf("invalid filter followed by valid coefficients: invalid output samples=%d, recovered tail=%.6f\n",invalid,last);
+    sf_renderer_destroy(renderer);sf_ring_destroy(ring);return invalid==0&&fabs(last-.5)<1e-4;
+}
+
+int main(void){
+    int ok=nonfinite();ok=starvation()&&ok;ok=poisoned_filter()&&ok;
+    ok=normal_audio(48000,0,0,4)&&ok;
+    ok=normal_audio(44100,0,0,4)&&ok;
+    ok=normal_audio(44100,150,-300,60)&&ok;
+    return ok?0:1;
+}
