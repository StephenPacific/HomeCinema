+/// Select a complete recent chunk without crossing the first observed frame of
+/// this capture epoch. A reanchor must accumulate fresh lag + chunk history;
+/// old ring samples cannot acquire timestamps from the new mapping.
+func liveExportCursor(writtenFrame: Int64, minimumFrame: Int64, lagFrames: Int64, chunkFrames: Int) -> Int64? {
+    guard writtenFrame >= 0, minimumFrame >= 0, lagFrames >= 0,
+          writtenFrame >= lagFrames, chunkFrames > 0 else { return nil }
+    let chunk = Int64(chunkFrames)
+    let remainder = minimumFrame % chunk
+    let adjustment = remainder == 0 ? 0 : chunk - remainder
+    guard minimumFrame <= Int64.max - adjustment else { return nil }
+    let floor = minimumFrame + adjustment
+    let latest = writtenFrame - lagFrames
+    guard latest >= floor, latest - floor >= chunk else { return nil }
+    let newestCompleteStart = latest - latest % chunk - chunk
+    return newestCompleteStart >= floor ? newestCompleteStart : nil
+}
