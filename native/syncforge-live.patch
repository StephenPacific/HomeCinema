+/// An immutable copy of the capture frame ↔ monotonic-host mapping. Consumers
+/// can bridge it to another clock without querying wall time for every packet.
+public struct ProgramTimelineSnapshot: Sendable {
+    public let anchorFrame: Int64
+    public let anchorHost: UInt64
+    public let framesPerTick: Double
+    public let epoch: UInt32
+
+    public init(anchorFrame: Int64, anchorHost: UInt64, framesPerTick: Double, epoch: UInt32) {
+        self.anchorFrame = anchorFrame
+        self.anchorHost = anchorHost
+        self.framesPerTick = framesPerTick
+        self.epoch = epoch
+    }
+
+    /// Signed host-tick offset of a source frame relative to a pinned host time.
+    public func hostOffsetTicks(frame: Int64, relativeTo referenceHost: UInt64) -> Double? {
+        guard frame >= 0, anchorFrame >= 0, framesPerTick.isFinite, framesPerTick > 0 else { return nil }
+        let frameOffset = Double(frame) - Double(anchorFrame)
+        let anchorOffset = Double(Int64(bitPattern: anchorHost &- referenceHost))
+        let result = anchorOffset + frameOffset / framesPerTick
+        return result.isFinite ? result : nil
+    }
+}
