+func appendLE(_ value: UInt32, to data: inout Data) {
+    var le = value.littleEndian
+    withUnsafeBytes(of: &le) { data.append(contentsOf: $0) }
+}
+func appendLE(_ value: UInt64, to data: inout Data) {
+    var le = value.littleEndian
+    withUnsafeBytes(of: &le) { data.append(contentsOf: $0) }
+}
+
+func makeProgramPacket(sampleRate: UInt32, sequence: UInt32, samples: [Float], presentation: PacketPresentation?) -> Data {
+    var packet = Data((presentation == nil ? "HCA1" : "HCA2").utf8)
+    for value in [sampleRate, 2, UInt32(samples.count / 2), sequence] { appendLE(value, to: &packet) }
+    if let timing = presentation {
+        appendLE(timing.streamId, to: &packet)
+        appendLE(timing.sourceFrame, to: &packet)
+        appendLE(timing.captureMasterMs.bitPattern, to: &packet)
+        appendLE(timing.presentationDelayMs.bitPattern, to: &packet)
+    }
+    var payload = Data(count: samples.count * MemoryLayout<UInt32>.size)
+    payload.withUnsafeMutableBytes { raw in
+        let output = raw.bindMemory(to: UInt32.self)
+        for i in samples.indices { output[i] = samples[i].bitPattern.littleEndian }
+    }
+    packet.append(payload)
+    return packet
+}
